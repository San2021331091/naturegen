DEVICE=auto
FRONTEND_ORIGIN=http://localhost:3000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
ALLOWED_IMAGE_HOSTS=images.unsplash.com,images.pexels.com,upload.wikimedia.org
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
# Set only after obtaining permission for ML use from the provider.
UNSPLASH_ML_PERMISSION=false
PEXELS_ML_PERMISSION=false
MAX_IMAGE_CACHE_MB=64
IMAGE_REQUEST_TIMEOUT=15
TORCH_NUM_THREADS=4
NATUREGEN_SD_MODEL=segmind/tiny-sd
# FRONTEND_ORIGIN accepts a comma-separated list (local dev plus a hosted frontend).
